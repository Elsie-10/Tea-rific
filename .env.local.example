# Copy this file to .env.local and fill in real values before running the app locally

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required when running node scripts/seed.js. Rotate the password after setup.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-long-unique-password

# NextAuth settings
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_string

# Optional: internal base URL used in some API callbacks
NEXTAUTH_URL_INTERNAL=http://localhost:3000

# M-Pesa Daraja (sandbox defaults)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Optional override for callback URL (recommended with ngrok in local dev)
MPESA_CALLBACK_BASE_URL=
