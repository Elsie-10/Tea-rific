# =============================================
# Tea-Terrific Bakery — Environment Variables
# Copy this file to .env.local and fill in values
# =============================================

# ── Supabase ──────────────────────────────────
# From: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Initial owner seed credentials ────────────
# Required only when running: node scripts/seed.js
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-long-unique-password

# ── NextAuth ──────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── M-Pesa Daraja ─────────────────────────────
# 'sandbox' for testing | 'production' for live
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
# Optional override for webhook callbacks in local dev (e.g., https://xxxx.ngrok-free.app)
# Falls back to NEXTAUTH_URL_INTERNAL, then NEXTAUTH_URL
MPESA_CALLBACK_BASE_URL=
